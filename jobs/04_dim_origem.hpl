        <precision>-1</precision>
        <currency>$</currency>
        <decimal>.</decimal>
        <group>,</group>
      </field>
      <field>
        <name>servico_padrao</name>
        <length>27</length>
        <type>String</type>
        <format/>
        <trim_type>none</trim_type>
