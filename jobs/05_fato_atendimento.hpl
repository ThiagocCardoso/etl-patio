  <transform>
    <type>TableInput</type>
    <name>Fato: ler stg_limpo</name>
    <sql>   SELECT id_registro AS id_atendimento,
          placa, tipo_servico, nome_status, nome_responsavel,
          dt_hora_entrada, dt_hora_inicio_manutencao, dt_hora_conclusao, dt_hora_liberacao,
          km_entrada,
          TO_CHAR(dt_hora_entrada, 'YYYYMMDD')::int AS sk_data_entrada,
          EXTRACT(HOUR FROM dt_hora_entrada)::int AS sk_hora_entrada,
          TO_CHAR(dt_hora_conclusao, 'YYYYMMDD')::int AS sk_data_conclusao,
          TO_CHAR(dt_hora_liberacao, 'YYYYMMDD')::int AS sk_data_liberacao,
          ROUND(EXTRACT(EPOCH FROM (dt_hora_liberacao - dt_hora_entrada)) / 60)::int AS tempo_permanencia_min,
          ROUND(EXTRACT(EPOCH FROM (dt_hora_conclusao - dt_hora_entrada)) / 60)::int AS tempo_ate_conclusao_min,
          ROUND(EXTRACT(EPOCH FROM (dt_hora_liberacao - dt_hora_conclusao)) / 60)::int AS tempo_aguardando_liberacao_min,
          ROUND(EXTRACT(EPOCH FROM (dt_hora_inicio_manutencao - dt_hora_entrada)) / 60)::int AS tempo_espera_min,
          ROUND(EXTRACT(EPOCH FROM (dt_hora_conclusao - dt_hora_inicio_manutencao)) / 60)::int AS tempo_execucao_min,
          1 AS qtd_atendimento
   FROM stg_limpo</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>dw_patio</connection>
