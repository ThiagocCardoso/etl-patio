    <action>
      <sql>   INSERT INTO log_execucao (job, inicio, fim, linhas_lidas, linhas_carregadas, linhas_rejeitadas, linhas_descartadas, status, mensagem)
   SELECT '00_principal', (SELECT MAX(dt_carga) FROM stg_atendimento), NOW(),
          l.lidas, f.carregadas, r.rejeitadas, l.lidas - f.carregadas - r.rejeitadas,
          'Sucesso', 'Carga concluída (dados simulados)'
   FROM (SELECT COUNT(*) AS lidas FROM stg_atendimento) l,
        (SELECT COUNT(*) AS carregadas FROM fatoatendimento) f,
        (SELECT COUNT(*) AS rejeitadas FROM rej_atendimento) r</sql>
      <connection>dw_patio</connection>
      <useVariableSubstitution>N</useVariableSubstitution>
      <sqlfromfile>N</sqlfromfile>
      <sqlfilename/>
      <sqlfilename_encoding/>
      <sendOneStatement>N</sendOneStatement>
