  <transform>
    <type>RegexEval</type>
    <name>Serviço: tem 3 letras</name>
    <script>.*[a-z].*[a-z].*[a-z].*</script>
    <matcher>servico_chave</matcher>
    <resultfieldname>servico_valido</resultfieldname>
