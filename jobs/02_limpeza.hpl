      <formula>
        <field_name>motivo_rejeicao</field_name>
        <formula>   IF(ISBLANK([placa_limpa]),"placa vazia",IF(NOT([placa_valida]),"placa inválida",IF(NOT([servico_valido]),"serviço inválido",IF(ISBLANK([status_limpo]),"status inválido",IF(AND(NOT(ISBLANK([km_entrada])),[km_entrada]&lt;0),"quilometragem negativa",IF(ISBLANK([dt_hora_entrada]),"data de chegada inválida",IF(AND([status_limpo]="Liberado",ISBLANK([dt_hora_liberacao])),"liberado sem horário de liberação",IF(OR(AND(NOT(ISBLANK([dt_hora_liberacao])),[dt_hora_liberacao]&lt;[dt_hora_entrada]),AND(NOT(ISBLANK([dt_hora_conclusao])),[dt_hora_conclusao]&lt;[dt_hora_entrada]),AND(NOT(ISBLANK([dt_hora_liberacao])),NOT(ISBLANK([dt_hora_conclusao])),[dt_hora_liberacao]&lt;[dt_hora_conclusao])),"datas incoerentes",""))))))))</formula>
        <value_type>2</value_type>
        <value_length>-1</value_length>
        <value_precision>-1</value_precision>
        <replace_field/>
        <set_na>N</set_na>
      </formula>
