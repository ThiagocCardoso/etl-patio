  <transform>
    <type>Formula</type>
    <name>Serviço: nome final</name>
    <formulas>
      <formula>
        <field_name>servico_final	</field_name>
        <formula>IF(ISBLANK([servico_padrao]),UPPER(LEFT(TRIM([servico]),1))&amp;LOWER(MID(TRIM([servico]),2,100)),[servico_padrao])</formula>
        <value_type>2</value_type>
        <value_length>-1</value_length>
        <value_precision>-1</value_precision>
        <replace_field/>
        <set_na>N</set_na>
      </formula>
      <formula>
        <field_name>servico_novo	</field_name>
        <formula>IF(ISBLANK([servico_padrao]),"S","N")</formula>
        <value_type>2</value_type>
        <value_length>-1</value_length>
        <value_precision>-1</value_precision>
        <replace_field/>
        <set_na>N</set_na>
      </formula>
    </formulas>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>144</xloc>
      <yloc>304</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>ReplaceString</type>
    <name>Datas: uniformizar formato</name>
    <fields>
      <field>
        <in_stream_name>data_hora_chegada</in_stream_name>
        <out_stream_name>	chegada_txt</out_stream_name>
        <use_regex>Y</use_regex>
        <replace_string>^(\d{4})-(\d{2})-(\d{2})</replace_string>
        <replace_by_string>$3/$2/$1</replace_by_string>
        <set_empty_string>N</set_empty_string>
