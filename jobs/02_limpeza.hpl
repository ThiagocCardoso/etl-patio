        <replace_string>^(\d{4})-(\d{2})-(\d{2})</replace_string>
        <replace_by_string>$3/$2/$1</replace_by_string>
        <set_empty_string>N</set_empty_string>
        <replace_field_by_string/>
        <whole_word>N</whole_word>
        <case_sensitive>N</case_sensitive>
        <is_unicode>N</is_unicode>
      </field>
      <field>
        <in_stream_name>data_hora_termino</in_stream_name>
        <out_stream_name>termino_txt</out_stream_name>
        <use_regex>Y</use_regex>
        <replace_string>^(\d{4})-(\d{2})-(\d{2})</replace_string>
